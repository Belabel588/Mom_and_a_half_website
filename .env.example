# Copy this file to .env (which is gitignored) and fill in real values.
# The contact form works without any of this filled in — submissions still
# get saved to server/data/submissions.json — but no email will be sent
# until SMTP_HOST/SMTP_USER/SMTP_PASS/CONTACT_RECEIVER_EMAIL are all set.

# SMTP credentials for the account the notification email is sent FROM.
# Works with any SMTP provider. For Gmail: smtp.gmail.com, port 465, and an
# "app password" (Google Account -> Security -> 2-Step Verification -> App
# passwords) — not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password

# The address every submission gets emailed to.
CONTACT_RECEIVER_EMAIL=mom@example.com

# Port the API server listens on locally.
PORT=3001
